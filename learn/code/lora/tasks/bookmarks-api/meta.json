{
  "domain": "bookmarks",
  "app_name": "Markpile",
  "stack": ["fastapi", "jinja2", "sqlite-utils"],
  "requirements": [
    "GET / home page shows the app name",
    "GET /bookmarks lists bookmarks and renders an add form",
    "POST /bookmarks creates a bookmark and redirects 303 to /bookmarks",
    "POST /bookmarks/{id}/pin sets pinned=1 and redirects 303",
    "POST /bookmarks/{id}/unpin sets pinned=0 and redirects 303",
    "migration 004_index_pinned creates idx_bookmarks_pinned",
    "migration 003_add_color adds the color column",
    "migration 002_backfill_created_at leaves no null created_at",
    "all four migrations recorded in _migrations",
    "re-running migrations is a no-op",
    "GET /summary returns exact integer keys total/pinned/unpinned with total==pinned+unpinned"
  ],
  "shapes": [
    "second-endpoint-of-a-pair",
    "exact-status-code",
    "write-apply-track-idempotent-migration",
    "exact-json-shape"
  ]
}
