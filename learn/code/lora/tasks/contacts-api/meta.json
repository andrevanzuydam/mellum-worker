{
  "domain": "contacts",
  "app_name": "Rolodex",
  "stack": ["fastapi", "jinja2", "sqlite-utils"],
  "requirements": [
    "GET / home page shows the app name",
    "GET /contacts lists contacts and renders an add form",
    "POST /contacts creates a contact and redirects 303 to /contacts",
    "POST /contacts/{id}/star sets starred=1 and redirects 303",
    "POST /contacts/{id}/unstar sets starred=0 and redirects 303",
    "migration 004_index_starred creates idx_contacts_starred",
    "migration 003_add_phone adds the phone column",
    "migration 002_backfill_created_at leaves no null created_at",
    "all four migrations recorded in _migrations",
    "re-running migrations is a no-op",
    "GET /summary returns exact integer keys total/starred/unstarred with total==starred+unstarred"
  ],
  "shapes": [
    "second-endpoint-of-a-pair",
    "exact-status-code",
    "write-apply-track-idempotent-migration",
    "exact-json-shape"
  ]
}
