{
  "domain": "bookings",
  "app_name": "Slots",
  "stack": ["fastapi", "jinja2", "sqlite-utils"],
  "requirements": [
    "GET / home page shows the app name",
    "GET /bookings lists bookings and renders a booking form",
    "POST /bookings creates a booking and redirects 303 to /bookings",
    "POST /bookings/{id}/confirm sets confirmed=1 and redirects 303",
    "POST /bookings/{id}/cancel sets confirmed=0 and redirects 303",
    "migration 004_index_confirmed creates idx_bookings_confirmed",
    "migration 003_add_seats adds the seats column",
    "migration 002_backfill_created_at leaves no null created_at",
    "all four migrations recorded in _migrations",
    "re-running migrations is a no-op",
    "GET /summary returns exact integer keys total/confirmed/unconfirmed with total==confirmed+unconfirmed"
  ],
  "shapes": [
    "second-endpoint-of-a-pair",
    "exact-status-code",
    "write-apply-track-idempotent-migration",
    "exact-json-shape"
  ]
}
